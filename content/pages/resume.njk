---
layout: base.njk
permalink: /resume/
title: Resume
schema: true
description: >-
  Resume of Jovian Finch Nordgren — Senior Technical Artist. Bungie, Epic
  Games, Left Turn Studios, DigiPen.
---
<section class="page-section">
  <div class="container">
    <div class="section-head">
      <p class="section-eyebrow mono">Sheet C — record</p>
      <h1>Resume</h1>
      <div class="section-ruler" aria-hidden="true"></div>
    </div>

    <div class="resume-actions mono">
      <a class="btn btn--secondary" href="/resume/Resume.html?print" target="_blank" rel="noopener">Print / save PDF</a>
      <a class="btn btn--secondary" href="/jovian-nordgren-resume.md" download>Markdown source</a>
    </div>

    <div class="contact-block contact-block--resume">
      <h3 class="mono">Contact</h3>
      <p class="contact-item">
        Email: <span data-em="{{ site.contact | emailPayload }}"><button class="reveal-btn mono" type="button">Show email</button><noscript>enable JavaScript, or find me on LinkedIn</noscript></span>
      </p>
      {%- if phonePayload %}
      <p class="contact-item">
        Phone: <span data-ph="{{ phonePayload }}"><button class="reveal-btn mono" type="button">Show phone</button></span>
      </p>
      {%- endif %}
      <p class="contact-item">
        LinkedIn: <a href="{{ site.contact.linkedin }}" target="_blank" rel="noopener">linkedin.com/in/JovianFinch</a>
      </p>
    </div>

    <div class="resume-body">
      <h1>{{ site.name }}</h1>
      <h3>{{ resume.role }}</h3>

      <h2>Profile</h2>
      <p>{{ resume.profile }}</p>

      <h2>Experience</h2>
      {%- for j in resume.experience %}
      <h3>{{ j.title }}{% if j.company %} | {{ j.company }}{% endif %} | {{ j.location }}</h3>
      <p><strong>{{ j.datesLong }}</strong>{% if j.projectLine %}<br><em>{{ j.projectLine }}</em>{% endif %}{% if j.subRole %}<br><em>{{ j.subRole }}</em>{% endif %}</p>
      {%- if j.intro %}
      <p>{{ j.intro }}</p>
      {%- endif %}
      {%- if j.bullets %}
      <ul>
        {%- for b in j.bullets %}
        <li>{{ b }}</li>
        {%- endfor %}
      </ul>
      {%- endif %}
      {%- for sub in j.subSections %}
      <p><strong>{{ sub.headingLead }} — {{ sub.headingRest }} ({{ sub.dates }})</strong></p>
      <p>{{ sub.text }}</p>
      {%- endfor %}
      {%- if not loop.last %}<hr>{% endif %}
      {%- endfor %}

      <h2>Skills</h2>
      <ul>
        {%- for s in resume.skillsGrid %}
        <li><strong>{{ s.label }}:</strong> {{ s.items }}</li>
        {%- endfor %}
      </ul>

      <h2>Education</h2>
      {%- for e in resume.education %}
      <p><strong>{{ e.degree }}{% if e.extra %} | {{ e.extra }}{% endif %}</strong><br>{{ e.school }}</p>
      {%- endfor %}
    </div>
  </div>
</section>
