---
layout: base.njk
---
{#- Standalone long-form guide (e.g. /ai-101/). Same plate and prose styles as the
    project pages; the sidebar holds a contents list from front matter `contents`
    (ids must match the <h2 id="..."> headings in the body) and the credits. #}
<header class="project-hero">
  <div class="container">
    <p class="project-breadcrumb mono">
      <a href="/">Home</a>
      <span>/</span>
      {{ eyebrow or "Guide" }}
    </p>
    <h1 class="project-title">{{ title }}</h1>
    {%- if meta %}
    <div class="project-meta mono">
      {%- for m in meta %}
      <span class="project-meta-item"><strong>{{ m.label }}</strong> {{ m.value }}</span>
      {%- endfor %}
    </div>
    {%- endif %}
  </div>
</header>

<section class="project-content">
  <div class="container">
    <div class="project-content__inner">

      <div class="project-body guide-body">
        {{ content | safe }}
      </div>

      <aside class="project-sidebar guide-sidebar">
        {%- if contents %}
        <nav class="sidebar-block" aria-label="Contents">
          <h3 class="mono">Contents</h3>
          <ol class="guide-contents">
            {%- for c in contents %}
            <li><a href="#{{ c.id }}">{{ c.label }}</a></li>
            {%- endfor %}
          </ol>
        </nav>
        {%- endif %}
        {%- for block in sidebar %}
        <div class="sidebar-block">
          <h3 class="mono">{{ block.title }}</h3>
          <p>{% for l in block.lines %}{{ l }}{% if not loop.last %}<br>{% endif %}{% endfor %}</p>
        </div>
        {%- endfor %}
      </aside>

    </div>
  </div>
</section>
