<header class="site-header">
  <div class="container">
    <a class="site-logo" href="/">{{ site.name }}</a>
    <button class="nav-toggle" aria-label="Open navigation" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
    <nav class="site-nav" aria-label="Main navigation">
      {%- for item in site.nav %}
      <a href="{{ item.url }}"{% if page.url == item.url or (item.url != "/" and page.url.startsWith(item.url)) %} class="active" aria-current="page"{% endif %}>{{ item.label }}</a>
      {%- endfor %}
    </nav>
  </div>
</header>
